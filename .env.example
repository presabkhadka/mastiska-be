PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mastiskadb
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h
REDIS_URL=redis://localhost:6379
GEMINI_API_KEY=your-google-ai-studio-key
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
ANSWER_MODEL=gemini-3.8-flash
ANSWER_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
ASK_RATE_LIMIT_PER_MINUTE=5
ASK_RATE_LIMIT_PER_DAY=50
ASSISTANT_RATE_LIMIT_PER_MINUTE=5
ASSISTANT_RATE_LIMIT_PER_DAY=50
EMBED_JOBS_PER_MINUTE=20
REFRESH_CRON=0 0,12 * * *
REFRESH_TIMEZONE=Asia/Kathmandu
REFRESH_MAX_PER_RUN=500
REFRESH_MAX_PER_USER_PER_RUN=20
REFRESH_RATE_LIMIT_PER_MINUTE=5
REFRESH_RATE_LIMIT_PER_DAY=50
LOGIN_RATE_LIMIT_PER_IP_PER_MINUTE=10
LOGIN_RATE_LIMIT_PER_EMAIL_PER_15_MIN=10
REGISTER_RATE_LIMIT_PER_IP_PER_HOUR=5
TRUST_PROXY_HOPS=0
